<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="task-feed" value="artifacts/packages" />
    <add key="cached-dependencies" value="../../../artifacts/packages" />
    <add key="machine-cache" value="C:/Users/jianx/.nuget/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="task-feed">
      <package pattern="Bing.Offices.*" />
    </packageSource>
    <packageSource key="cached-dependencies">
      <package pattern="*" />
    </packageSource>
    <packageSource key="machine-cache">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
