<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Bing.Offices.Npoi</AssemblyName>
    <PackageId>Bing.Offices.Npoi</PackageId>
    <Description>Bing.Offices.Npoi是Bing应用框架的Npoi相关操作核心类库。
Bing是一个.net core平台下的应用框架，旨在于提升小型团队的开发能力，由常用公共操作类、架构基类、第三方组件封装、第三方业务接口封装等组成。</Description>
  </PropertyGroup>

  <Import Project="..\..\framework.props" />

  <ItemGroup>
    <Compile Include="..\provider-shared\ExcelSheetContent.cs"
             Link="Bing\Offices\Exports\ExcelSheetContent.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bing.Offices.Core\Bing.Offices.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\provider-shared\ExcelXlsxZipPreflight.cs"
             Link="Bing\Offices\Imports\ExcelXlsxZipPreflight.cs" />
    <Compile Include="..\provider-shared\ExcelWorkbookBatchProjection.cs"
             Link="Bing\Offices\Imports\ExcelWorkbookBatchProjection.cs" />
    <Compile Include="..\provider-shared\ExcelEntityBatchProjection.cs"
             Link="Bing\Offices\Entities\ExcelEntityBatchProjection.cs" />
    <Compile Include="..\provider-shared\ExcelTemporaryStorageBudget.cs"
             Link="Bing\Offices\Entities\ExcelTemporaryStorageBudget.cs" />
    <Compile Include="..\provider-shared\ExcelEntityRowPlan.cs"
             Link="Bing\Offices\Entities\ExcelEntityRowPlan.cs" />
    <Compile Include="..\provider-shared\ExcelEntityPageAnchorNames.cs"
             Link="Bing\Offices\Entities\ExcelEntityPageAnchorNames.cs" />
    <Compile Include="..\provider-shared\ExcelEntitySubtotalImportScanner.cs"
