<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Bing.Offices.ExcelDataReader</AssemblyName>
    <PackageId>Bing.Offices.ExcelDataReader</PackageId>
    <Description>Bing.Offices 的 ExcelDataReader 只读 Provider。</Description>
  </PropertyGroup>

  <Import Project="..\..\framework.props" />

  <ItemGroup>
    <ProjectReference Include="..\Bing.Offices.Core\Bing.Offices.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\provider-shared\ExcelXlsxZipPreflight.cs"
             Link="Bing\Offices\IO\ExcelXlsxZipPreflight.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>
</Project>
