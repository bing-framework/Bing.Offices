<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Target Name="ValidateBingOfficesPackageVersion" BeforeTargets="Restore;Build">
    <Error Condition="'$(BingOfficesPackageVersion)' == ''"
           Text="BingOfficesPackageVersion must be supplied from the packages produced by this build." />
  </Target>

  <ItemGroup>
    <Compile Remove="artifacts/**" />
    <EmbeddedResource Remove="artifacts/**" />
    <None Remove="artifacts/**" />
    <Compile Include="..\package-consumer-shared\AdvancedPivotPackageContract.cs" Link="AdvancedPivotPackageContract.cs" />
    <Compile Include="..\package-consumer-shared\AdvancedPivotPackageRow.cs" Link="AdvancedPivotPackageRow.cs" />
    <Compile Include="..\package-consumer-shared\BasicPivotPackageContract.cs" Link="BasicPivotPackageContract.cs" />
    <Compile Include="..\package-consumer-shared\BasicPivotPackageRow.cs" Link="BasicPivotPackageRow.cs" />
    <Compile Include="..\package-consumer-shared\ExcelDataReaderFailurePackageContract.cs" Link="ExcelDataReaderFailurePackageContract.cs" />
    <PackageReference Include="Bing.Offices.Npoi" Version="$(BingOfficesPackageVersion)" />
    <PackageReference Include="Bing.Offices.MiniExcel" Version="$(BingOfficesPackageVersion)" />
    <PackageReference Include="Bing.Offices.ClosedXml" Version="$(BingOfficesPackageVersion)" />
    <PackageReference Include="Bing.Offices.ExcelDataReader" Version="$(BingOfficesPackageVersion)" />
    <PackageReference Include="Bing.Offices.SpreadCheetah" Version="$(BingOfficesPackageVersion)" />
    <PackageReference Include="Bing.Offices.AsposeCells" Version="$(BingOfficesPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>
</Project>
