<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\common.tests.props" />
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.7.4" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" PrivateAssets="all" />
    <PackageReference Include="GenFu" Version="1.6.0" />
    <PackageReference Include="Bing.Utils.IdUtils" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <ProjectReference Include="..\Bing.Offices.ResourceProbe\Bing.Offices.ResourceProbe.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bing.Offices.Abstractions\Bing.Offices.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Bing.Offices.Core\Bing.Offices.Core.csproj" />
    <ProjectReference Include="..\..\src\Bing.Offices.Npoi\Bing.Offices.Npoi.csproj" />
    <ProjectReference Include="..\Bing.Offices.ProfileFixtures\Bing.Offices.ProfileFixtures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\**\*.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
