<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="production" value="../../artifacts/packages" />
    <add key="contracts" value="../../artifacts/packages-contracts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="production">
      <package pattern="Bing.Offices.Abstractions" />
      <package pattern="Bing.Offices.Core" />
      <package pattern="Bing.Offices.MiniExcel" />
      <package pattern="Bing.Offices.Npoi" />
      <package pattern="Bing.Offices.ClosedXml" />
      <package pattern="Bing.Offices.SpreadCheetah" />
      <package pattern="Bing.Offices.SpreadCheetah" />
    </packageSource>
    <packageSource key="contracts">
      <package pattern="Bing.Offices.EntityProviderContracts" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
